// App Store and TestFlight configuration. Local account selection stays untracked.
SPOTTER_BUNDLE_ID = app.spotter.dev
SPOTTER_ENTITLEMENTS = App/Release.entitlements
SPOTTER_APP_GROUP = group.app.spotter.dev
SPOTTER_WATCH_FLAGS = SPOTTER_HEALTHKIT
SPOTTER_WATCH_ENTITLEMENTS = SpotterWatch/SpotterWatch.entitlements
SPOTTER_SIGNING_STYLE = Automatic
SPOTTER_SIGNING_IDENTITY = Apple Development
#include? "../Distribution.local.xcconfig"
